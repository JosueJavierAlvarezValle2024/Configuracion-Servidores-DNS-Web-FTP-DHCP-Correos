# =============================================================================
#  master.cf - Servicios de Postfix - Tarea 4.3
#  Ruta en el servidor: /etc/postfix/master.cf
#
#  Columnas: servicio  tipo  privado  sin_root  chroot  activacion  limite  comando
#  Las lineas que empiezan con espacios y "-o" cambian opciones de main.cf
#  solo para ese servicio.
# =============================================================================
# ==========================================================================
# service type  private unpriv  chroot  wakeup  maxproc command + args
#               (yes)   (yes)   (no)    (never) (100)
# ==========================================================================

# Puerto 25 (SMTP): correo que llega de otros servidores. Sin autenticacion;
# solo acepta mensajes PARA empresa.lan (no reenvia a otros dominios).
smtp      inet  n       -       y       -       -       smtpd

# Puerto 587 (SUBMISSION): los usuarios envian su correo desde Thunderbird.
#  - TLS obligatorio (STARTTLS) antes de cualquier otra cosa
#  - usuario y contrasena obligatorios (Dovecot SASL)
#  - cada usuario solo puede enviar con su propia direccion como remitente
submission inet n       -       y       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=yes
  -o smtpd_sender_login_maps=texthash:/etc/postfix/buzones
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_sender_login_mismatch,permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING

# --- Servicios internos de Postfix (valores de Debian/Ubuntu) ---
pickup    unix  n       -       y       60      1       pickup
cleanup   unix  n       -       y       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       y       1000?   1       tlsmgr
rewrite   unix  -       -       y       -       -       trivial-rewrite
bounce    unix  -       -       y       -       0       bounce
defer     unix  -       -       y       -       0       bounce
trace     unix  -       -       y       -       0       bounce
verify    unix  -       -       y       -       1       verify
flush     unix  n       -       y       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       y       -       -       smtp
relay     unix  -       -       y       -       -       smtp
  -o syslog_name=postfix/$service_name
showq     unix  n       -       y       -       -       showq
error     unix  -       -       y       -       -       error
retry     unix  -       -       y       -       -       error
discard   unix  -       -       y       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
# Cliente LMTP: entrega los mensajes a Dovecot
lmtp      unix  -       -       y       -       -       lmtp
anvil     unix  -       -       y       -       1       anvil
scache    unix  -       -       y       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd
